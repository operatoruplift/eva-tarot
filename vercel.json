{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/*.mjs": {"maxDuration": 45, "includeFiles": "src/data/**"}
  },
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
