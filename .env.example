# Copy to .env for local development. Server-only credentials; never add VITE_
# prefixes to secrets or commit your .env file.
# The app defaults to the online reader. The hosted endpoint still requires
# explicit activation and a provider. Requests can incur provider charges.
# Local on-device AI remains optional; it does not use these credentials.
HOSTED_AI_ENABLED=true

# Direct OpenAI takes precedence over the gateway when both keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional server-side Vercel AI Gateway key (works locally or on Vercel).
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1

# Set true on Vercel only after AI Gateway billing/access is enabled and verified.
# With true and neither key set, handlers obtain a fresh platform OIDC token on
# every request. No OIDC token should be copied into this file.
AI_GATEWAY_ENABLED=false
# With HOSTED_AI_ENABLED=true, either explicit API key works regardless of the
# OIDC opt-in above. Without a provider, the enabled endpoint returns unavailable.
# The server's throttle is instance-local. Production also uses a Vercel WAF
# reading rate limit and the existing AI Gateway project spending budget.
PORT=3001

# Commerce and optional private journal backup.
# Public project coordinates, safe to include in the browser build:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server proxy coordinates (same project):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only 256-bit key. Store only its SHA-256 hash in eva_server_credentials.
EVA_COMMERCE_INTERNAL_KEY=
# Fail closed when paid/trial mode is selected but commerce is unavailable.
EVA_PRICING_MODE=free_trial
